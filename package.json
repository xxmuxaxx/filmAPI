{
  "name": "filmapi",
  "description": "Учебный проект с библиотекой фильмов",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && npm run lint:architecture",
    "test": "vitest run",
    "format:check": "prettier --check src",
    "lint:architecture": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fontsource/roboto": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "antd": "^6.6.6",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "lodash-es": "^4.18.1",
    "react": "^19.3.0",
    "react-content-loader": "^7.1.2",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
